{
  "name": "dsh-research-then-build",
  "version": "0.5.0",
  "type": "module",
  "description": "Research before you build: /research makes the agent survey existing solutions before writing code, implement in the open, and pass an independent review — delivery is blocked on reinvented wheels and unverified work.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "ai-coding",
    "code-review",
    "self-reflection",
    "reinvent-the-wheel",
    "build-vs-buy",
    "open-source-first",
    "research-first",
    "prior-art",
    "agent-workflow",
    "prompt-engineering"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astonmy/dsh-research-then-build.git"
  },
  "homepage": "https://github.com/Astonmy/dsh-research-then-build#readme",
  "bugs": {
    "url": "https://github.com/Astonmy/dsh-research-then-build/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/state.test.mjs test/report.test.mjs test/fingerprint.test.mjs test/store.test.mjs",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-subagent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  }
}
